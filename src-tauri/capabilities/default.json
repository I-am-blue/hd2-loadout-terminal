{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:allow-save",
    "core:webview:allow-set-webview-zoom",
    "updater:default",
    "process:allow-restart"
  ]
}
