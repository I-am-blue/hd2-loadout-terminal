{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HD2 战术配装终端",
  "version": "0.1.0",
  "identifier": "dev.hd2loadout.terminal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HD2 战术配装终端",
        "width": 1440,
        "height": 900,
        "minWidth": 1060,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "非官方 HD2 单人战术配装评估工具",
    "longDescription": "离线可用的 HD2 单人配装选择、八维规则评分与可选 AI 战术报告。",
    "category": "Game",
    "copyright": "Copyright © 2026 HD2 Loadout Terminal contributors",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzOEFCNEQ3RkEwM0UxMDYKUldRRzRRUDYxN1NLNDFTc3NlR3dFVnlyNDNieFFVNnlRazM2cFpJMmZIT0t6SmI3aTBBRzErWWUK",
      "endpoints": [
        "https://github.com/I-am-blue/hd2-loadout-terminal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
